{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReVibe",
  "version": "1.0.0",
  "identifier": "ai.vibedeck.app",
  "build": {
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../frontend"
    },
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://127.0.0.1:5173"
  },
  "app": {
    "windows": [
      {
        "title": "ReVibe",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "url": "http://127.0.0.1:9377",
        "decorations": true,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "deb"
    ],
    "icon": [
      "../electron/revibe-icon.png"
    ],
    "resources": [
      "../../sidecar",
      "../../frontend/dist"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      }
    }
  }
}
